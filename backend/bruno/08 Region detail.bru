meta {
  name: 08 Region detail
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/regions/25760/kpis
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().kpis.length).to.equal(4);
    expect(res.getBody().source.source_code).to.equal("SIM-4G-2026-10");
    expect(res.getBody().kpis.some((k) => k.series.some((p) => p.status === "ok"))).to.equal(true);
  });
}
