meta {
  name: 06 KPI values gio
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/kpi-values?kpi=cssr&level=ward&at=2026-10-15T20:00
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items.length).to.equal(168); expect(res.getBody().source.data_nature).to.equal("simulated");
    expect(res.getBody().source.source_code).to.equal("SIM-4G-2026-10");
    expect(res.getBody().items.some((i) => i.status === "ok")).to.equal(true);
  });
}
